{
    "compilerOptions": {
        "target": "ESNext",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ],
        "skipLibCheck": true
    },
    "include": [
        "tests/**/*.ts",
        "pages/**/*.ts",
        "playwright.config.ts"
    ]
}